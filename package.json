{
  "name": "dsh-subscription-agents",
  "version": "1.2.0",
  "description": "Use local Codex and Claude Code subscription accounts as DeepSeek Harness models and continuable child agents.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "claude-code",
    "subagents",
    "ai-agents"
  ],
  "homepage": "https://github.com/adsqwui/dsh-subscription-agents#readme",
  "bugs": {
    "url": "https://github.com/adsqwui/dsh-subscription-agents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsqwui/dsh-subscription-agents.git"
  },
  "license": "MIT",
  "author": "adsqwui",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "accounts.js",
    "agent-runner.js",
    "native-bridge.js",
    "compat.js",
    "cli.js",
    "codex-usage.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "workspace-ui/index.js",
    "workspace-ui/client.js",
    "workspace-ui/package.json",
    "workspace-ui/LICENSE",
    "workspace-ui/icon.svg",
    "workspace-ui/locale/*.json",
    "README.md",
    "LICENSE",
    "spec"
  ],
  "scripts": {
    "test": "node --test *.test.js"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
