{
  "name": "@local/dsh-subscription-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "accounts.js",
    "agent-runner.js",
    "native-bridge.js",
    "cli.js",
    "codex-usage.js",
    "client.js",
    "client.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "workspace-ui",
    "README.md",
    "spec"
  ],
  "peerDependencies": { "@deepseek-ai/dsh-llm": "0.2.2-rc.3" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
