+ * @returns the direct parent for a catalogued child, otherwise `selected`.
+ */
+export function browserRootSessionId(list: SessionListState, selected: SessionId): SessionId {
+  for (const [parentId, projection] of Object.entries(list.projectionsBySession)) {
+    if (projection.values.subagentCatalog?.some(child => child.id === selected && child.mode === 'continuable') === true) {
+      return parentId as SessionId
+    }
+  }
